<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Model Comparison Benchmark {{.RunID}}</title>
<style>
  :root {
    --bg: #f6f7f5; --fg: #1c2320; --muted: #5d6762; --line: #cfd6d1; --grid: #e2e6e3; --panel: #ffffff; --warn: #b5542e;
    --zone: #e3f0e9; --frontier: #7d8a84;
    --c1: #2f6f5e; --c2: #b5542e; --c3: #4b5fa8; --c4: #8a7a1f; --c5: #7d3f8f; --c6: #2c7fa3;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #141917; --fg: #e3e8e5; --muted: #9aa6a0; --line: #35403b; --grid: #28312d; --panel: #1c2421; --warn: #e88a63;
      --zone: #1e3329; --frontier: #8a9791;
      --c1: #6fbfa8; --c2: #e88a63; --c3: #8fa2ea; --c4: #d4c35a; --c5: #c792d6; --c6: #74c1e3; }
  }
  .p1 { --pal: var(--c1); } .p2 { --pal: var(--c2); } .p3 { --pal: var(--c3); }
  .p4 { --pal: var(--c4); } .p5 { --pal: var(--c5); } .p6 { --pal: var(--c6); }
  body { margin: 0; background: var(--bg); color: var(--fg); padding: 1.2rem 16px 3rem;
    font: 15px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 64rem; margin: 0 auto; }
  h1 { font-size: 1.6rem; margin: 0 0 .2rem; }
  h2 { margin-top: 2.2rem; border-bottom: 1px solid var(--line); padding-bottom: .2rem; font-size: 1.2rem; }
  h3 { font-size: 1.05rem; margin: 1.4rem 0 .4rem; }
  h4 { font-size: .95rem; margin: 1rem 0 .3rem; color: var(--muted); }
  .meta { color: var(--muted); font-size: .9rem; }
  .warn { border-left: 4px solid var(--warn); padding: .4rem .8rem; background: var(--panel); }
  .note { border-left: 4px solid var(--line); padding: .3rem .8rem; background: var(--panel); font-size: .9rem; }
  .scroll { overflow-x: auto; }
  .chart { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: .6rem .8rem; min-width: 0; margin: 0 0 1rem; }
  .chart svg { width: 100%; height: auto; display: block; }
  table { border-collapse: collapse; font-size: .88rem; min-width: 100%; }
  th, td { border: 1px solid var(--line); padding: .25rem .5rem; text-align: left; vertical-align: top; white-space: nowrap; }
  th { background: var(--panel); }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .swatch { display: inline-block; width: .8em; height: .8em; border-radius: 50%; margin-right: .35em; vertical-align: -.05em; background: var(--pal); }
  .tag { display: inline-block; font-size: .75rem; border: 1px solid var(--line); border-radius: 3px; padding: 0 .3em; margin-left: .3em; color: var(--muted); }
  .small { font-size: .8rem; color: var(--muted); white-space: normal; }
  svg text { fill: var(--fg); font-size: 15px; font-family: inherit; }
  svg .muted { fill: var(--muted); }
  svg .grid { stroke: var(--grid); stroke-width: 1; }
  svg .axis { stroke: var(--line); stroke-width: 1.5; }
  svg .zone { fill: var(--zone); }
  svg .frontier { stroke: var(--frontier); stroke-width: 1.5; stroke-dasharray: 4 3; fill: none; }
  svg .ci { stroke: var(--pal); stroke-width: 1.5; opacity: .5; }
  svg circle.point { fill: var(--pal); stroke: var(--bg); stroke-width: 2; }
  svg .leader { stroke: var(--pal); stroke-width: 1.2; }
  svg text.name { paint-order: stroke; stroke: var(--panel); stroke-width: 4px; stroke-linejoin: round; }
</style>
</head>
<body>
<main>
<h1>Model Comparison Benchmark</h1>
<p class="meta">Run {{.RunID}} · commit {{.Commit}} · started {{.Started}} · spent {{.Spent}} of {{.Max}}</p>
{{if .Violation}}<p class="warn">{{.Violation}}</p>{{end}}

<h2>Runs</h2>
<div class="scroll"><table>
  <tr><th>Run</th><th>Commit</th><th>Started</th><th>Go</th><th>gollem</th><th>agentkit</th><th>BigQuery client</th><th>Sampling</th></tr>
  {{range .Runs}}<tr><td>{{.Run}}</td><td>{{.Commit}}</td><td>{{.Started}}</td><td>{{.Go}}</td><td>{{.Gollem}}</td><td>{{.Agentkit}}</td><td>{{.BigQuery}}</td><td>{{.Sampling}}</td></tr>
  {{end}}
</table></div>

<h2>Quality and cost efficiency</h2>
{{range $c := .Charts}}
<figure class="chart">
<h3>{{.Label}}</h3>
<svg viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-label="Quality and cost efficiency of {{.Label}}">
  <rect class="zone" x="{{.ZoneX}}" y="{{.ZoneY}}" width="{{.ZoneW}}" height="{{.ZoneH}}"/>
  {{range .XTicks}}<line class="grid" x1="{{.At}}" y1="{{$c.Top}}" x2="{{.At}}" y2="{{$c.Bottom}}"/><text x="{{.At}}" y="{{$c.Bottom}}" dy="22" class="muted" text-anchor="middle">{{.Label}}</text>{{end}}
  {{range .YTicks}}<line class="grid" x1="{{$c.Left}}" y1="{{.At}}" x2="{{$c.Right}}" y2="{{.At}}"/><text x="{{$c.Left}}" y="{{.At}}" dx="-8" dy="5" class="muted" text-anchor="end">{{.Label}}</text>{{end}}
  <line class="axis" x1="{{.Left}}" y1="{{.Bottom}}" x2="{{.Right}}" y2="{{.Bottom}}"/><line class="axis" x1="{{.Left}}" y1="{{.Top}}" x2="{{.Left}}" y2="{{.Bottom}}"/>
  <text x="{{.MidX}}" y="{{.XTitleY}}" class="muted" text-anchor="middle">Cost efficiency</text>
  <text x="18" y="{{.MidY}}" class="muted" text-anchor="middle" transform="rotate(-90 18 {{.MidY}})">Quality</text>
  <text x="{{.Right}}" y="{{.Top}}" dx="-8" dy="22" class="muted" text-anchor="end">Low cost, high quality</text>
  {{if .Frontier}}<polyline class="frontier" points="{{.Frontier}}"/>{{end}}
  {{range .Points}}<g class="{{.Color}}"><line class="ci" x1="{{.X}}" y1="{{.QLow}}" x2="{{.X}}" y2="{{.QHigh}}"/><line class="ci" x1="{{.ELow}}" y1="{{.Y}}" x2="{{.EHigh}}" y2="{{.Y}}"/>{{if .Leader}}<line class="leader" x1="{{.X}}" y1="{{.Y}}" x2="{{.LeaderX}}" y2="{{.LeaderY}}"/>{{end}}<circle class="point" cx="{{.X}}" cy="{{.Y}}" r="9"><title>{{.Title}}</title></circle><text class="name" x="{{.LabelX}}" y="{{.LabelY}}">{{.Name}}</text></g>{{end}}
</svg>
<p class="small">{{.Compared}}</p>
<div class="scroll"><table>
  <tr><th>Candidate</th><th>Quality</th><th>Cost efficiency</th><th>Grounded (pass^1)</th><th>All 3 grounded (pass^3)</th><th>Reach / conduct</th><th>Mean cost per trial</th><th>Mean time per trial</th><th>Gap to best (quality)</th><th>Unmeasured scenarios</th></tr>
  {{range .Rows}}<tr><td><span class="swatch {{.Color}}"></span>{{.Name}}{{if .Baseline}}<span class="tag">baseline</span>{{end}}</td><td class="num">{{.Quality}}</td><td class="num">{{.Efficiency}}</td><td class="num">{{.Grounded}}</td><td class="num">{{.PassK}}</td><td class="num">{{.ReachConduct}}</td><td class="num">{{.MeanCost}}</td><td class="num">{{.MeanTime}}</td><td>{{.Gap}}</td><td class="num">{{.Unmeasured}}</td></tr>
  {{if .Difficulties}}<tr><td colspan="10" class="small">{{.Difficulties}}</td></tr>{{end}}
  {{end}}
</table></div>
</figure>
{{end}}

<h2>Candidates</h2>
<div class="scroll"><table>
  <tr><th>Candidate</th><th>Provider</th><th>Model</th><th>Spent</th><th>Baseline for</th></tr>
  {{range .Candidates}}<tr><td><span class="swatch {{.Color}}"></span>{{.Name}}</td><td>{{.Provider}}</td><td>{{.Model}}</td><td class="num">{{.Spent}}</td><td>{{.Baseline}}</td></tr>
  {{end}}
</table></div>

<h2>Results by scenario</h2>
{{range .Roles}}
<h3>{{.Label}}</h3>
{{range .Kinds}}
<h4>{{.Label}}</h4>
{{range .Scenarios}}
<p><strong>{{.Heading}}</strong></p>
{{if .Saturation}}<p class="note">{{.Saturation}}</p>{{end}}
{{if .Failure}}<p class="warn">This scenario was not run because its tables could not be loaded. Error: <code>{{.Failure}}</code></p>{{else}}
<div class="scroll"><table>
  <tr><th>Candidate</th><th>Grounded</th><th>All 3 grounded (pass^3)</th><th>Quality</th><th>Cost efficiency</th><th>Mean cost per trial</th><th>Mean time per trial</th><th>LLM calls (mean)</th><th>Actions (mean)</th><th>Quality lost to (trials)</th><th>Endings</th><th>Not run</th></tr>
  {{range .Rows}}<tr><td><span class="swatch {{.Color}}"></span>{{.Name}}</td><td class="num">{{.Grounded}}</td><td class="num">{{.PassK}}</td><td class="num">{{.Quality}}</td><td class="num">{{.Efficiency}}</td><td class="num">{{.MeanCost}}</td><td class="num">{{.MeanTime}}</td><td class="num">{{.Calls}}</td><td>{{.Actions}}</td><td>{{.Lost}}</td><td>{{.Endings}}</td><td class="num">{{.NotRun}}</td></tr>
  {{end}}
</table></div>
{{end}}
{{end}}
{{end}}
{{end}}
<p class="meta">"Grounded" is the number of trials that reached a grounded conclusion over the number of trials counted. Trials stopped by the run's spending limit and trials that ended in a provider error are not counted.</p>

{{if .NotRun}}
<h2>Trials not run</h2>
<p>The run reached its spending limit of {{.Max}}, so {{.NotRun}} trials were not started or were stopped. The "Not run" column of each scenario shows how many. Quality and cost efficiency come only from the trials that ran.</p>
{{end}}

{{if .Excluded}}
<h2>Scenarios not merged</h2>
<p>These scenarios differ between the result files, so they are not shown side by side. To compare candidates on them, run those candidates again at a single commit.</p>
<ul>{{range .Excluded}}<li>{{.}}</li>{{end}}</ul>
{{end}}
</main>
</body>
</html>
